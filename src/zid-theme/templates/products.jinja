{% extends "layout.jinja" %}

{#
  KET products / search results (?q=…): the search field again, then the products as the KET category
  page's cards (ket-category.css, under .kc), Zid's pages of 24 as round links. The + adds a product without
  options straight to the cart (the cart drawer shows it); a product with options opens its page.
#}
{% import 'components/ket/icons.jinja' as k %}
{% set ar = session.lang == 'ar' %}
{% set q = (session.query_params.get('q') or '') | trim %}
{% block title %}{{ store.name }} – {{ (('نتائج البحث: ' if ar else 'Search: ') ~ q) if q else _('All Products') }}{% endblock %}

{% block content %}
{% set R = products.results if products and products.results else [] %}
{% macro pimg(p, w=600) -%}
  {%- set im = p.main_image.image.large if p.main_image and p.main_image.image else (p.images[0].image.full_size if p.images else '') -%}
  {{- image_url(im, w=w, q=85, f='auto') if im else '' -}}
{%- endmacro %}
<link rel="stylesheet" href="{{ 'ket-category.css' | asset_url }}&k=3171005a">
<div class="kc ksearch">
  <section class="container ksearch__head">
    <p class="eyebrow">{{ ('نتائج البحث' if ar else 'Search results') if q else ('المتجر' if ar else 'The shop') }}</p>
    <h1>{% if q %}<span class="ksearch__q">«{{ q }}»</span>{% else %}{{ 'كل المنتجات' if ar else 'All products' }}{% endif %}</h1>
    <form class="ksearch__form" action="/products" method="get" role="search">
      <span class="ksearch__ico" aria-hidden="true">{{ k.icon('search', 22, 1.8) }}</span>
      <input type="search" name="q" value="{{ q }}" enterkeyhint="search" autocomplete="off" placeholder="{{ 'وش تدوّر عليه اليوم؟' if ar else 'What are you looking for today?' }}" aria-label="{{ 'بحث' if ar else 'Search' }}">
      <button type="submit">{{ 'ابحث' if ar else 'Search' }}</button>
    </form>
    {% if R %}<p class="ksearch__count">{{ (products.count ~ (' قطعة' if ar else (' piece' if products.count == 1 else ' pieces'))) }}</p>{% endif %}
  </section>

  <section class="container ksearch__grid">
    {% if R %}
      <div class="pgrid">
        {% for p in R %}
          {% set url = url_for('product_details', slug=p.slug) %}
          {% set pr = (p.price or 0) | float %}{% set sp = (p.sale_price or 0) | float %}{% set was = pr if sp and sp < pr else 0 %}
          <article class="card">
            <a class="card__media" href="{{ url }}"><img src="{{ pimg(p) }}" alt="{{ p.name }}" loading="{{ 'eager' if loop.index < 5 else 'lazy' }}" width="600" height="600">
              {% if was %}<span class="card__off" dir="ltr">−{{ ((1 - sp / pr) * 100) | round | int }}%</span>{% endif %}
              <button class="card__add" type="button" data-ket-add="{{ p.id }}" data-url="{{ url }}" data-options="{{ 'true' if p.has_options else 'false' }}" aria-label="{{ ('أضف للسلة: ' if ar else 'Add to cart: ') ~ p.name }}">{{ k.icon('plus', 20, 1.8) }}</button></a>
            <div class="card__body"><h3 class="card__name"><a href="{{ url }}">{{ p.name }}</a></h3>
              <p class="card__price"><b>{{ p.formatted_sale_price or p.formatted_price }}</b>{% if was %}<s>{{ p.formatted_price }}</s>{% endif %}</p></div>
          </article>
        {% endfor %}
      </div>
      {% include "components/ket/category-pager.jinja" %}
    {% else %}
      <div class="ksearch__none">
        <img src="{{ 'images/gazelle-box.webp' | asset_url }}" alt="" width="150" height="150">
        <h2>{{ 'ما لقينا شي بهالاسم' if ar else 'Nothing found by that name' }}</h2>
        <p>{{ 'جرّب كلمة ثانية، أو تصفّح الأقسام.' if ar else 'Try another word, or browse the departments.' }}</p>
        <a class="ksearch__btn" href="/categories">{{ 'تصفّح الأقسام' if ar else 'Browse departments' }}</a>
      </div>
    {% endif %}
  </section>
</div>
<script>
  // the + on a card: straight into Zid's cart (the cart drawer opens); a product with options opens its page
  document.addEventListener('click', async e => {
    const b = e.target.closest('[data-ket-add]'); if (!b) return; e.preventDefault();
    if (b.dataset.options === 'true' || !window.zid) { location.href = b.dataset.url; return; }
    b.disabled = true;
    try { await zid.cart.addProduct({ product_id: b.dataset.ketAdd, quantity: 1 }, { showErrorNotification: true });
      window.dispatchEvent(new CustomEvent('cart:updated', { detail: { productId: b.dataset.ketAdd, action: 'add' } })); }
    catch (err) { location.href = b.dataset.url; }
    b.disabled = false;
  });
</script>
{% endblock %}

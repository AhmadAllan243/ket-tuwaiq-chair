{#
  KET category page (design: ket-tables.html). Generated by ket/build_category.py: edit the prototype, this data
  block (ket/ket-category.data.jinja) or the script, then run the build. Works for every category: the headline is
  the category's name, "Shop by type" its sub-categories, the grid its products (Zid's pages of 24, ?page=2 …).
#}
{% extends "layout.jinja" %}

{% block title %}{{ store.name }} – {{ category.name }}{% endblock %}

{% block content %}
{# the lighting department has its own design (components/ket/lamps-page.jinja, built by ket/build_lamps.py) #}
{% if (category.id | string) == '444478' %}{% include 'components/ket/lamps-page.jinja' %}{% else %}
{% set R = products.results if products and products.results else [] %}
{% set SUBS = category.sub_categories if category.sub_categories else [] %}
{% macro href(v) %}{{ ((v._url if v and v._url else (v.url if v and v.url is string else (v or ''))) ~ '') | tojson }}{% endmacro %}
{% macro pimg(p, w=600) -%}
  {%- set im = p.main_image.image.large if p.main_image and p.main_image.image else (p.images[0].image.full_size if p.images else '') -%}
  {{- image_url(im, w=w, q=85, f='auto') if im else '' -}}
{%- endmacro %}
{% set first = pimg(R[0], 1600) if R else '' %}
{% set cover = category.cover_image or category.image %}
{% set KC_HERO = image_url(cover, w=1600, q=85, f='auto') if cover else first %}
{% set KC_PILL = pimg(R[0], 500) if R else KC_HERO %}
{% set KC_TYPES = SUBS | length > 1 %}
{# every department gets the whole design and the same photos; the tables keep their own types, collections and size guide #}
{% set nm = (category.name or '') | lower %}
{% set KC_TABLES = ('طاول' in nm) or ('table' in nm) %}
{% set KC_FULL = true %}
{% set KC_HERO = 'ket-cat/hero-joy.webp' | asset_url %}
{% set KC_BIG = 'ket-cat/life2.webp' | asset_url %}
{% if KC_TABLES %}
  {% set KC_PILL = 'ket-cat/t03.webp' | asset_url %}
  {% set KC_IPILL = 'ket-cat/t08.webp' | asset_url %}
  {% set KC_HELP = 'ket-cat/t11.webp' | asset_url %}
{% else %}
  {% set KC_IPILL = KC_PILL %}
  {% set KC_HELP = KC_PILL %}
{% endif %}
{% set KC_INTRO = KC_BIG %}
{# the trees department: its own look on top of the same page (assets/ket-trees.css + ket-trees.js): the watering loader,
   yellow and light green, the planting initiative banner and page, and its own photos #}
{% set KC_TREES = (category.id | string) == '444476' %}
{% if KC_TREES %}
  {% set KC_HERO = 'ket-trees/life-sofa.webp' | asset_url %}
  {% set KC_BIG = 'ket-trees/life-planter.webp' | asset_url %}
  {% set KC_INTRO = 'ket-trees/life-walk.webp' | asset_url %}
  {% set KC_HELP = 'ket-trees/life-room.webp' | asset_url %}
{% endif %}
{% set phone = (store.settings.contact.phone or '') | replace('+', '') | replace(' ', '') %}
{% set KC_WA = ('https://wa.me/' ~ phone) if phone else '#' %}
<link rel="stylesheet" href="{{ 'ket-category.css' | asset_url }}&k=9d3455bb">
{% if KC_TREES %}<link rel="stylesheet" href="{{ 'ket-trees.css' | asset_url }}&k=7183c2e7">{% endif %}
<script>
  try { if (!sessionStorage.getItem({{ ('ketTreesSeen' if KC_TREES else 'ketCatSeen') | tojson }}) && !/[?&]page=/.test(location.search)) document.documentElement.classList.add('is-loading'); } catch (e) {}   // the ring loader: first category visit of a session only
  window.KET_CAT = {
    {# KET's English name for this department is «Decorating supplies»; the site calls it Home essentials #}
    name: {{ ('Home essentials' if (category.id | string) == '444491' and session.lang == 'en' else category.name) | tojson }},
    sub: {{ ((category.description or '') | striptags | trim) | tojson }},
    full: {{ KC_FULL | tojson }},
    tables: {{ KC_TABLES | tojson }},
    trees: {{ KC_TREES | tojson }},
    heroImg: {{ KC_HERO | tojson }},
    tilePhoto: {{ (('ket-trees/leaf-fig.webp' if KC_TREES else 'ket-cat/life1.webp') | asset_url) | tojson }},
    pills: {% if KC_TABLES %}[{{ ('ket-cat/t03.webp' | asset_url) | tojson }}, {{ ('ket-cat/life1.webp' | asset_url) | tojson }}]{% else %}[{{ (pimg(R[0], 300) if R else '') | tojson }}, {{ (pimg(R[1], 300) if R | length > 1 else '') | tojson }}]{% endif %},
    types: [
      {% if KC_TYPES %}{% for s in SUBS %}
        {% set sp = namespace(img='') %}{% for p in R %}{% for c in (p.categories or []) %}{% if c.id == s.id and not sp.img %}{% set sp.img = pimg(p, 500) %}{% endif %}{% endfor %}{% endfor %}
        { id: {{ (s.id | string) | tojson }}, ar: {{ s.name | tojson }}, en: {{ s.name | tojson }},
          hero: {{ (image_url(s.image, w=500, q=85, f='auto') if s.image else sp.img) | tojson }} }{{ ',' if not loop.last }}
      {% endfor %}{% endif %}
    ],
    products: [
      {% for p in R %}
        {% set ty = namespace(id='') %}{% for c in (p.categories or []) %}{% for s in SUBS %}{% if c.id == s.id and not ty.id %}{% set ty.id = s.id | string %}{% endif %}{% endfor %}{% endfor %}
        { id: {{ (p.id | string) | tojson }}, type: {{ ty.id | tojson }}, ar: {{ p.name | tojson }}, en: {{ p.name | tojson }},
          url: {{ href(url_for('product_details', slug=p.slug)) }}, img: {{ pimg(p) | tojson }},
          price: {{ (p.sale_price if p.sale_price else p.price) | tojson }}, was: {{ (p.price if p.sale_price else 0) | tojson }},
          fprice: {{ (p.formatted_sale_price or p.formatted_price or '') | tojson }}, fwas: {{ (p.formatted_price if p.formatted_sale_price else '') | tojson }},
          hasOptions: {{ (p.has_options or false) | tojson }} }{{ ',' if not loop.last }}
      {% endfor %}
    ]
  };
  KET_CAT.products.forEach(p => { p.price = +p.price || 0; p.was = +p.was || 0; if (p.was <= p.price) p.was = 0; });
  if (!KET_CAT.tables) KET_CAT.types = KET_CAT.types.filter(x => KET_CAT.products.some(p => p.type === x.id));
</script>

<div class="kc{{ ' kc--trees' if KC_TREES }}">
<!-- LOADER: dots → line → logo → tables gather in a ring (plays on each visit; tap to skip) -->
<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__dots" id="ldDots"><i></i><i></i><i></i></div>
  {% if KC_TREES %}{% include "components/ket/trees-loader.jinja" %}{% endif %}
  <p class="loader__line" id="ldLine" data-t="loadLine"></p>
  <div class="ring" id="ring"></div>
  <div class="loader__logo" id="ldLogo"></div>
  <button class="loader__skip" id="ldSkip" type="button" data-t="skipIntro"></button>
</div>


<!-- 1 · HERO   → Vitrin: category banner (headline, photo, links from theme settings) -->
<section class="hero container" aria-labelledby="hTitle">
  <h1 class="hero__h" id="hTitle"></h1>
  <div class="hero__media">
    <div class="hero__card" id="heroCard">
      <img src="{{ KC_HERO }}" alt="" width="838" height="474" fetchpriority="high" id="heroImg">
      <a class="hero__shop" href="#all"><span data-t="hShop"></span><i class="flip" id="hShopIco"></i></a>
    </div>
    <div class="hero__stat" id="hStat"></div>
    <div class="live" id="live" aria-live="off"></div>
  </div>
</section>

<!-- 2 · PICK THE SHAPE   → Vitrin: sub-categories (tiles) + theme settings (photo, headline) -->
<section class="section container" id="shape" aria-labelledby="shapeTitle">
  <p class="eyebrow" data-t="typesEy" style="margin-bottom:16px"></p>
  <div class="shape">
    <div class="shape__cols" id="shapeCols"></div>
    <div class="shape__big" data-reveal>
      <img src="{{ KC_BIG }}" alt="" loading="lazy" width="1100" height="730">
      <div><h2 id="shapeTitle" data-t="typesH"></h2><p data-t="shapeTx"></p></div>
      <div class="shape__bar">
        <a class="sbtn flip" href="#all" id="shapeGo" data-t-aria="cardBtn"></a>
        <div class="sseg" id="shapeSeg"></div>
        <span class="sav"><img src="{{ KC_PILL }}" alt="" loading="lazy"></span>
      </div>
    </div>
  </div>
</section>

{% if KC_TREES %}{% include 'components/ket/trees-banner.jinja' %}{% endif %}
<!-- 4 · ALL PRODUCTS   → Vitrin: category.products with Zid's filters / sort -->
<section class="section container" id="all" aria-labelledby="gridTitle">
  <div class="grid__head">
    <div><p class="eyebrow" data-t="gridEy"></p><h2 class="h-xl" id="gridTitle" style="margin-top:10px"><span data-t="gridH"></span><sup id="gridSup"></sup></h2></div>
  </div>
  <div class="bar">
    <div class="filters" id="filters" role="group"></div>
    <label class="sortw"><span class="visually-hidden" data-t="sort"></span><select id="sort"></select><span id="sortIco"></span></label>
  </div>
  <p class="count" id="count" aria-live="polite"></p>
  <div class="pgrid" id="pgrid"></div>
  {% include "components/ket/category-pager.jinja" %}
</section>

<!-- 5 · COLLECTIONS -->
<section class="section container" aria-labelledby="colTitle">
  <div class="cols" id="cols">
    <div class="cols__head"><p class="eyebrow" data-t="colEy"></p><h2 id="colTitle" data-t="colH"></h2></div>
    <div class="cols__list" id="colList"></div>
    <div class="cfloat" id="cfloat"><img alt=""></div>
  </div>
</section>

<!-- 6 · INTRO BENTO   → Vitrin: category description + theme settings -->
<section class="section container" aria-labelledby="whyTitle">
  <div class="intro__grid">
    <div class="intro__left">
      <p class="eyebrow" data-t="whyEy"></p>
      <h2 class="intro__h" id="whyTitle" data-reveal><span data-t="whyA"></span><span class="ipill ipill--cut"><img src="{{ KC_IPILL }}" alt="" loading="lazy"></span><span data-t="whyB"></span></h2>
      <div class="chips" id="chips"></div>
      <div class="acc" id="acc"></div>
    </div>
    <div class="intro__card" data-reveal>
      <div class="intro__copy">
        <p class="eyebrow" id="cardEy"></p>
        <p data-t="cardTx"></p>
        <h3 data-t="cardH"></h3>
        <a class="btn btn-primary" href="#all"><span data-t="cardBtn"></span><span class="arr flip" id="cardArr"></span></a>
      </div>
      <div class="photo">
        <img src="{{ KC_INTRO }}" alt="" loading="lazy" width="1100" height="730" data-par>
        <span class="pill tag" id="saleChip"></span>
        <div class="stat">
          <div class="stat__row"><span class="stat__lbl" data-t="fromLbl"></span><span class="stat__big" id="statFrom"></span></div>
          <div class="stat__foot"><span class="stack" id="statStack"></span><span class="stat__lbl" id="statTx"></span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 7 · SIZE GUIDE -->
<section class="section container" aria-labelledby="sizeTitle">
  <div class="size">
    <div class="size__copy">
      <p class="eyebrow eyebrow--o" data-t="sizeEy"></p>
      <h2 id="sizeTitle" data-t="sizeH"></h2>
      <p data-t="sizeTx"></p>
      <div class="range"><label for="sofa"><span data-t="sofa"></span><output id="sofaOut" for="sofa"></output></label><input type="range" id="sofa" min="160" max="320" step="10" value="240"></div>
      <div class="size__res"><div><span data-t="rec"></span><b id="recOut"></b></div><div><span data-t="gap"></span><b class="num"><span dir="ltr">40–45</span><small data-t="cm"></small></b></div></div>
      <button class="btn btn-primary" id="sizeBtn" type="button" style="justify-self:start;margin-top:6px"><span data-t="sizeBtn"></span><span class="arr flip" id="sizeArr"></span></button>
    </div>
    <div class="size__plan"><svg id="plan" viewBox="0 0 400 300" role="img" aria-label="Sofa and coffee table, top view"></svg></div>
  </div>
</section>

<!-- 8 · HELP -->
<section class="help" aria-labelledby="helpTitle">
  <div class="container">
    <div class="help__card" data-reveal>
      <div class="help__img"><img src="{{ KC_HELP }}" alt="" loading="lazy"></div>
      <div class="help__copy"><h2 id="helpTitle" data-t="helpH"></h2><p data-t="helpTx"></p><a class="btn btn-wa" href="{{ KC_WA }}" target="_blank" rel="noopener"><span data-t="helpBtn"></span><span class="arr" id="helpArr"></span></a></div>
    </div>
  </div>
</section>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
{% if KC_TREES %}{% include "components/ket/trees-page.jinja" %}{% endif %}
</div>

{% include 'components/products/quick-view-modal.jinja' %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script src="{{ 'ket-brand.js' | asset_url }}&k=08686d58"></script>
<script src="{{ 'ket-category.js' | asset_url }}&k=e984ef52"></script>
{% if KC_TREES %}<script src="{{ 'ket-trees.js' | asset_url }}&k=771bcf68"></script>{% endif %}
{% endif %}
{% endblock %}

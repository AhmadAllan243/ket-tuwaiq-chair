{% extends "layout.jinja" %}

{% block title %}{{ store.name }} – {{ _('Cart') }}{% endblock %}

{% block content %}
  {#
    KET cart page (same look as the cart drawer, components/ket/cart-drawer.jinja): Zid's own parts (lines,
    quantities, coupon, gift, loyalty, totals, payment widgets) inside KET cards; styles in ket/overrides.css, "Cart page".
  #}
  {% set ar = session.lang == 'ar' %}
  <div class="ket kcart">
    <div class="container">
      <header class="kcart__head">
        <p class="eyebrow"><span>{{ 'سلة المشتريات' if ar else 'Shopping cart' }}</span></p>
        <h1>{{ 'سلتك' if ar else 'Your cart' }}{% if cart.products_count > 0 %} <span class="num">({{ cart.products_count }})</span>{% endif %}</h1>
      </header>
      {% if cart.products_count > 0 %}
        <div class="cart-with-products kcart__grid">
          <div class="kcart__main">
            {% include 'vitrin:cart/progressive_discount.jinja' %}
            {% include 'components/cart/shipping-progress.jinja' %}
            <div class="kcart__card kcart__items" data-cart-products-list>
              {% include 'vitrin:v2/cart/products_list.jinja' %}
              {% if store.settings.checkout.gift_order_settings.is_gift_order_enabled == '1' and not cart.gift_card_details.card_product_id and not cart.gift_card_details.card_design %}
                <div class="mt-4">{% include 'components/cart/gift-card-display.jinja' %}</div>
              {% endif %}
            </div>
            <a href="{{ url_for('home') }}" class="kcart__back">
              <svg class="rtl:rotate-180" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              {{ 'كمّل التسوق' if ar else 'Continue shopping' }}
            </a>
          </div>
          <aside class="kcart__side">
            <div class="mb-3">{% include 'vitrin:cart/customer_wallet_progress.jinja' %}</div>
            <div class="kcart__card kcart__sum">
              {% include 'components/cart/loyalty-program.jinja' %}
              {% include 'components/cart/coupon-code.jinja' %}
              {% include 'components/cart/gift-order.jinja' %}
              <div class="kcart__pay">
                {% include 'components/cart/order-summary.jinja' %}
                {% include 'components/cart/checkout-buttons.jinja' %}
                {% include 'vitrin:shared/bank_discounts.jinja' %}
                <div data-payment-widgets>{% include 'vitrin:cart/payment_widgets.jinja' %}</div>
                {% include 'vitrin:checkout/apple-pay-quick-checkout.jinja' %}
              </div>
            </div>
          </aside>
        </div>
      {% else %}
        <div class="cart-empty kcart__empty">
          <img src="{{ 'images/gazelle-box.webp' | asset_url }}" alt="" width="170" height="170">
          <h2>{{ 'سلتك فاضية' if ar else 'Your cart is empty' }}</h2>
          <p>{{ 'غزالنا ينتظر أول قطعة تختارها.' if ar else 'Our gazelle is waiting for your first piece.' }}</p>
          <a class="kcart__btn" href="{{ url_for('home') }}">{{ 'كمّل التسوق' if ar else 'Continue shopping' }}</a>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}

{% block footer_scripts %}
  {# Cart Controller - Modular cart page functionality #}
  <script
    src="{{ 'dist/cart-controller.js' | asset_url }}"
    defer
  ></script>
  <!-- prettier-ignore-start -->
  <script>
    // Initialize CartPage module after DOM is ready
    document.addEventListener("DOMContentLoaded", function () {
    // This must happen BEFORE any cart operations to prevent default HTML replacement
    (function registerHandler() {
      if (window.ZidCart && window.ZidCart.registerCustomHandler) {
        window.ZidCart.registerCustomHandler();
      } else {
        // If ZidCart isn't ready yet, try again on next tick
        setTimeout(registerHandler, 10);
      }
    })();
      CartPage.init({
        cart: {{ cart | tojson }},
        loyaltyEnabled: {{ (store.settings.checkout.is_loyalty_enabled | default(false)) | tojson }},
        cartTotalValue: {{ cart.total_value | default(0) }},
        storeCurrencyCode: "{{ session.currency.code }}",
        cartCurrencyCode: "{{ cart.currency.cart_currency.code if cart.currency else session.currency.code }}",
        translations: {
          forPointsGetDiscount: "{{ _('For %(points)s points get %(discount)s discount') }}",
          itemsCount: "{{ _('%(count)s items') }}",
          freeShippingApplied: "{{ _('Free shipping applied!') }}",
          addMoreForFreeShipping: "{{ _('Add %(total)s more to get free shipping') }}",
          discount: "{{ _('Discount') }}",
          loyalty: "{{ _('Loyalty') }}"
        }
      });
    });
  </script>
  <!-- prettier-ignore-end -->
{% endblock %}

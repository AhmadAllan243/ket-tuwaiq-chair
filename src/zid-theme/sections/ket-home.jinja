{#
  KET home page (design: ket-home.html). Generated by ket/build_home.py: edit the prototype, this data block
  (ket/ket-home.data.jinja) or the script, then run the build. Everything left empty in the theme editor
  falls back to the prototype's wording and pictures.
#}
{% set S = settings %}
{% macro pic(v, w=900) %}{{ (image_url(v, w=w, q=85, f='auto') if v else '') | tojson }}{% endmacro %}
{% macro href(v) %}{{ ((v._url if v and v._url else (v.url if v and v.url is string else (v or ''))) ~ '') | tojson }}{% endmacro %}
{% macro txt(v) %}{{ (v or '') | tojson }}{% endmacro %}
<link rel="stylesheet" href="{{ 'ket-home.css' | asset_url }}&k=f121de9d">
<script>
  document.documentElement.classList.add('is-intro');   // the welcome (short once seen this visit) ends by handing over to the search bar
  window.KET_HOME = {
    base: {{ ('ket-home/home-lady.webp' | asset_url) | tojson }}.replace(/home-lady\.webp.*$/, ''),
    {# the section's links, else the store's own accounts (Settings → contact) #}
    {% set C = store.settings.contact %}
    links: { instagram: {{ href(S.instagram) if S.instagram else ((('https://www.instagram.com/' ~ C.instagram) if C and C.instagram else '') | tojson) }},
             tiktok: {{ href(S.tiktok) if S.tiktok else ((('https://www.tiktok.com/@' ~ C.tiktok) if C and C.tiktok else '') | tojson) }} },
    saleUrl: {{ href(S.sale_url) }},
    lady: {{ pic(S.lady, 700) if S.lady else ('home/lady' | tojson) }},
    fan: [{{ pic(S.sale_image1, 400) if S.sale_image1 else ('cut/ac03' | tojson) }}, {{ pic(S.sale_image2, 400) if S.sale_image2 else ('cut/lp10' | tojson) }}, {{ pic(S.sale_image3, 400) if S.sale_image3 else ('cut/t13' | tojson) }}],
    text: {
      heroH: {{ txt(S.hero_title) }}, heroTx: {{ txt(S.hero_text) }},
      brandT: {{ txt(S.brand_title) }}, brandT2: {{ txt(S.brand_title2) }}, pill1: {{ txt(S.pill1) }}, pill2: {{ txt(S.pill2) }},
      featT: {{ txt(S.sale_title) }}, clrEy: {{ txt(S.deals_eyebrow) }}, clrH: {{ txt(S.deals_title) }}, clrTx: {{ txt(S.deals_text) }},
      expH: {{ txt(S.videos_title) }}, expTx: {{ txt(S.videos_text) }}
    },
    depts: {
      {% for id in ['tables', 'trees', 'home', 'rugs', 'lamps'] %}
        {% set c = S['dept_' ~ id] %}
        {{ id }}: {
          name: {{ txt(c.name if c and c.id else '') }},
          url: {{ txt(('/categories/' ~ c.id ~ '/' ~ c.slug) if c and c.id else '') }},
          n: {{ (c.products_count if c and c.products_count else 0) | tojson }},
          text: {{ txt(S['dept_' ~ id ~ '_text']) }},
          photo: {{ pic(S['dept_' ~ id ~ '_image'], 1100) if S['dept_' ~ id ~ '_image'] else ('' | tojson) }}
        }{{ ',' if not loop.last }}
      {% endfor %}
    },
    floats: [
      {% set fl = safeget(S, 'floats', []) %}
      {% if fl %}
        {% for f in fl %}{ img: {{ pic(f.image, 400) }}, url: {{ href(f.url) }}, cut: {{ (f.cutout or false) | tojson }} }{{ ',' if not loop.last }}{% endfor %}
      {% else %}
        { img: 'home/lp03', cut: true }, { img: 'home/life/family' }, { img: 'home/tr06', cut: true },
        { img: 'tables/t12', cut: true }, { img: 'home/life/tables' }, { img: 'home/life/home' }
      {% endif %}
    ],
    {% set st = safeget(S, 'story', []) %}
    st: [{% for s in st %}{% if s.text_a or s.text_h %}[{{ txt(s.text_a) }}, {{ txt(s.text_h) }}, {{ txt(s.text_b) }}]{{ ',' if not loop.last }}{% endif %}{% endfor %}],
    story: [
      {% if st %}
        {% for s in st %}{ img: {{ pic(s.image, 800) }}, name: {{ txt(s.title) }}, price: {{ txt(s.price) }}, url: {{ href(s.url) }} }{{ ',' if not loop.last }}{% endfor %}
      {% else %}
        { img: 'tables/t08' }, { img: 'home/lp11' }, { img: 'home/ac05' }
      {% endif %}
    ],
    {% set deals = S.deals.results if S.deals and S.deals.results else [] %}
    {% set scale = S.deals_stock_scale or 30 %}
    products: [
      {% for p in deals %}
        {% set im = p.main_image.image.large if p.main_image and p.main_image.image else (p.images[0].image.full_size if p.images else '') %}
        { id: {{ p.id | tojson }}, ar: {{ txt(p.name) }}, en: {{ txt(p.name) }}, url: {{ href(url_for('product_details', slug=p.slug)) }},
          img: {{ pic(im, 800) if im else ('' | tojson) }}, price: {{ (p.sale_price if p.sale_price else p.price) | tojson }}, was: {{ (p.price if p.sale_price else 0) | tojson }},
          fprice: {{ txt(p.formatted_sale_price or p.formatted_price) }}, fwas: {{ txt(p.formatted_price if p.formatted_sale_price else '') }},
          hasOptions: {{ (p.has_options or false) | tojson }} }{{ ',' if not loop.last }}
      {% endfor %}
    ],
    clearance: [
      {% for p in deals %}
        { id: {{ p.id | tojson }}, left: {{ (p.quantity if p.quantity and not p.is_infinite else 0) | tojson }}, total: {{ scale | tojson }} }{{ ',' if not loop.last }}
      {% endfor %}
    ],
    videos: [
      {% set vs = safeget(S, 'videos', []) %}
      {% if vs %}
        {% for v in vs %}{ poster: {{ pic(v.poster, 700) }}, video: {{ href(v.video) }}, title: {{ txt(v.title) }}, sub: {{ txt(v.subtitle) }} }{{ ',' if not loop.last }}{% endfor %}
      {% else %}
        { poster: 'home/v1' }, { poster: 'home/v4' }, { poster: 'home/v2' }, { poster: 'home/v5' }, { poster: 'home/v3' }, { poster: 'home/v6' }
      {% endif %}
    ]
  };
  KET_HOME.products.forEach(p => { p.price = +p.price || 0; p.was = +p.was || 0; if (p.was && p.was <= p.price) p.was = 0; });
  KET_HOME.clearance.forEach(d => { d.price = (KET_HOME.products.find(p => p.id === d.id) || {}).price || 0; d.left = +d.left || 0; d.total = Math.max(+d.total || 1, d.left); });
</script>

<div class="kh">
<!-- INTRO: "Hello! 👋", a typed welcome, three dots, and the dots become the search bar (once per visit) -->
<div class="intro" id="intro">
  <div class="intro__wrap" id="introWrap">
    <div class="intro__hello" id="introHello" aria-hidden="true"></div>
    <p class="intro__line" id="introLine"></p>
  </div>
  <div class="intro__dots" id="introDots" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="intro__pill" id="introPill" aria-hidden="true"></div>
  <button class="intro__skip" id="introSkip" type="button" data-t="skipIntro"></button>
</div>


  <!-- 1. HERO: greeting, the smart search, departments, a strip of products -->
  <section class="hero container" aria-labelledby="heroH">
    <div class="hero__in">
      <div class="greet" id="greet"><span class="wave is-on" aria-hidden="true">👋🏼</span><span class="greet__txt" id="greetTxt"></span></div>
      <h1 class="hero__h" id="heroH" data-t="heroH"></h1>
      <p class="hero__tx" data-t="heroTx"></p>
    <form class="sbox" id="sbox" role="search" autocomplete="off">
      <span class="sbox__tip" id="sTip" data-t="idleTip" aria-hidden="true"></span>
      <div class="sbox__field" id="sField">
        <span class="sbox__lead" id="sLead" aria-hidden="true"></span>
        <label class="visually-hidden" for="q" data-t="sLabel"></label>
        <input class="sbox__input" id="q" type="search" enterkeyhint="search" spellcheck="false" placeholder=" " role="combobox" aria-expanded="false" aria-controls="sres" aria-autocomplete="list">
        <span class="sbox__ph" id="sPh" aria-hidden="true"></span>
        <button class="sbox__clear" id="sClear" type="button" data-t-aria="sClear"></button>
        <button class="sbox__go" id="sGo" type="submit" data-t-aria="sGo"></button>
      </div>
      <div class="sres" id="sres" role="listbox" data-lenis-prevent></div>
    </form>
      <div class="hero__chips" id="heroChips"></div>
    </div>
    <div class="floaters" id="floaters"></div>
  </section>

  <!-- 2. ABOUT -->
  <section class="story" id="story" aria-label="About ket">
    <div class="story__pin container">
      <div class="story__copy">
        <div class="story__meta"><span class="eyebrow" data-t="stEy"></span><span class="story__count latin"><b id="stN">01</b> / 03</span></div>
        <div class="story__slides" id="storySlides"></div>
        <div class="story__bars" id="stBars"><i></i><i></i><i></i></div>
      </div>
      <div class="story__art" id="storyArt"></div>
    </div>
  </section>

  <!-- 3. DEPARTMENTS -->
  <section class="container dept" id="cats" aria-labelledby="catH">
    <div class="head"><span class="eyebrow" data-t="catEy"></span><h2 class="h2" id="catH" data-t="catH"></h2></div>
    <div class="bento" id="catGrid"></div>
  </section>

  <!-- 4. 24-HOUR CLEARANCE -->
  <section class="section container" id="deals" aria-labelledby="clrH">
    <div class="clr">
      <div class="clr__head">
        <div class="head" style="margin:0">
          <span class="clr__ey"><span class="fire" aria-hidden="true">🔥</span><span data-t="clrEy"></span></span>
          <h2 class="h2" id="clrH" data-t="clrH"></h2>
          <p class="sub" data-t="clrTx"></p>
        </div>
        <div class="clock-w"><span class="clock__lbl" data-t="nextDrop"></span><div class="clock" id="clock" role="timer" aria-live="off"></div></div>
      </div>
      <div class="sb" id="sb">
        <div class="sb__stage" id="sbStage" tabindex="0" aria-roledescription="carousel"></div>
        <div class="sb__card">
          <div class="sb__txt" id="sbTxt" aria-live="polite"></div>
          <button class="btn btn-ink sb__buy" id="sbBuy" type="button"></button>
        </div>
      </div>
      <div class="car__nav">
        <button class="car__btn flip" id="carPrev" type="button" data-t-aria="prev"></button>
        <div class="car__dots" id="carDots"></div>
        <button class="car__btn flip" id="carNext" type="button" data-t-aria="next"></button>
      </div>
    </div>
  </section>

  <!-- 5. CUSTOMER VIDEOS -->
  <section class="section" id="exp" aria-labelledby="expH">
    <div class="container exp__head">
      <div class="head" style="margin:0"><h2 class="h2" id="expH" data-t="expH"></h2><p class="sub" data-t="expTx"></p></div>
      <div class="socials">
        <a class="soc" id="lnkIg" href="#" target="_blank" rel="noopener"><i id="icoIg"></i><span data-t="expIg"></span></a>
        <a class="soc" id="lnkTt" href="#" target="_blank" rel="noopener"><i id="icoTt"></i><span data-t="expTt"></span></a>
      </div>
    </div>
    <div class="fan" id="fan" tabindex="0" aria-roledescription="carousel"></div>
    <p class="fan__cap" id="fanCap" aria-live="polite"></p>
    <div class="car__nav">
      <button class="car__btn flip" id="fanPrev" type="button" data-t-aria="prev"></button>
      <div class="car__dots" id="fanDots"></div>
      <button class="car__btn flip" id="fanNext" type="button" data-t-aria="next"></button>
    </div>
  </section>

  <!-- 6. VISITORS -->
  <section class="section container" aria-labelledby="visH">
    <div class="vis">
      <div class="vis__head"><span class="eyebrow" data-t="visEy"></span><h2 class="h2" id="visH" data-t="visH"></h2></div>
      <div class="stats">
        <div class="stat stat--now"><b id="vNow">0</b><span data-t="visNow"></span></div>
        <div class="stat"><b id="vWeek">0</b><span data-t="visWeek"></span></div>
        <div class="stat"><b id="vMonth">0</b><span data-t="visMonth"></span></div>
      </div>
      <div class="vis__art"><img src="{{ 'ket-home/home-reading.webp' | asset_url }}" alt="" loading="lazy" width="566" height="464"></div>
    </div>
  </section>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<dialog class="vbox" id="vbox">
  <div class="vbox__in" id="vboxIn"></div>
</dialog>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script src="{{ 'ket-brand.js' | asset_url }}&k=e76b049a"></script>
<script src="{{ 'ket-home.js' | asset_url }}&k=685ef24c"></script>

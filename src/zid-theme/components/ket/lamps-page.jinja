{#
  KET lighting department (design: ket-lamps.html). Generated by ket/build_lamps.py: edit the design or this block in
  the script, then run the build. Shown by templates/category.jinja for category 444478.
#}
{% set R = products.results if products and products.results else [] %}
{% macro href(v) %}{{ ((v._url if v and v._url else (v.url if v and v.url is string else (v or ''))) ~ '') | tojson }}{% endmacro %}
{% macro pimg(p, w=900) -%}
  {%- set im = p.main_image.image.large if p.main_image and p.main_image.image else (p.images[0].image.full_size if p.images else '') -%}
  {{- image_url(im, w=w, q=85, f='auto') if im else '' -}}
{%- endmacro %}
{% set phone = (store.settings.contact.phone or '') | replace('+', '') | replace(' ', '') %}
{% set KL_WA = ('https://wa.me/' ~ phone) if phone else '#' %}
<link rel="stylesheet" href="{{ 'ket-lamps.css' | asset_url }}&k=21ba43cb">
<script>
  try { if (!sessionStorage.getItem('ketLampsSeen') && !/[?&]page=/.test(location.search)) document.documentElement.classList.add('is-loading'); } catch (e) {}   // the ring loader: first visit of a session only
  window.KET_LAMPS = {
    name: {{ category.name | tojson }},
    assets: {
      "bed-on": {{ ('ket-lamps/bed-on.webp' | asset_url) | tojson }},
      "globe-off": {{ ('ket-lamps/globe-off.webp' | asset_url) | tojson }},
      "globe-on": {{ ('ket-lamps/globe-on.webp' | asset_url) | tojson }},
      "help-bed": {{ ('ket-lamps/help-bed.webp' | asset_url) | tojson }},
      "hero-off": {{ ('ket-lamps/hero-off.webp' | asset_url) | tojson }},
      "hero-on": {{ ('ket-lamps/hero-on.webp' | asset_url) | tojson }},
      "lady-on": {{ ('ket-lamps/lady-on.webp' | asset_url) | tojson }},
      "lp01-on": {{ ('ket-lamps/lp01-on.webp' | asset_url) | tojson }},
      "lp02-on": {{ ('ket-lamps/lp02-on.webp' | asset_url) | tojson }},
      "lp03-on": {{ ('ket-lamps/lp03-on.webp' | asset_url) | tojson }},
      "lp04-on": {{ ('ket-lamps/lp04-on.webp' | asset_url) | tojson }},
      "lp05-on": {{ ('ket-lamps/lp05-on.webp' | asset_url) | tojson }},
      "lp06": {{ ('ket-lamps/lp06.webp' | asset_url) | tojson }},
      "lp06-on": {{ ('ket-lamps/lp06-on.webp' | asset_url) | tojson }},
      "lp07-on": {{ ('ket-lamps/lp07-on.webp' | asset_url) | tojson }},
      "lp08-on": {{ ('ket-lamps/lp08-on.webp' | asset_url) | tojson }},
      "lp09-on": {{ ('ket-lamps/lp09-on.webp' | asset_url) | tojson }},
      "lp10-on": {{ ('ket-lamps/lp10-on.webp' | asset_url) | tojson }},
      "lp11-on": {{ ('ket-lamps/lp11-on.webp' | asset_url) | tojson }},
      "lp12-on": {{ ('ket-lamps/lp12-on.webp' | asset_url) | tojson }},
      "lp13-on": {{ ('ket-lamps/lp13-on.webp' | asset_url) | tojson }},
      "lp14-on": {{ ('ket-lamps/lp14-on.webp' | asset_url) | tojson }},
      "lp15-on": {{ ('ket-lamps/lp15-on.webp' | asset_url) | tojson }},
      "lp16-on": {{ ('ket-lamps/lp16-on.webp' | asset_url) | tojson }},
      "lp17-on": {{ ('ket-lamps/lp17-on.webp' | asset_url) | tojson }},
      "lp18-on": {{ ('ket-lamps/lp18-on.webp' | asset_url) | tojson }},
      "lp19-on": {{ ('ket-lamps/lp19-on.webp' | asset_url) | tojson }},
      "lp20-on": {{ ('ket-lamps/lp20-on.webp' | asset_url) | tojson }},
      "lp21-on": {{ ('ket-lamps/lp21-on.webp' | asset_url) | tojson }},
      "lp22-on": {{ ('ket-lamps/lp22-on.webp' | asset_url) | tojson }},
      "lp23": {{ ('ket-lamps/lp23.webp' | asset_url) | tojson }},
      "lp23-on": {{ ('ket-lamps/lp23-on.webp' | asset_url) | tojson }},
      "lp24-on": {{ ('ket-lamps/lp24-on.webp' | asset_url) | tojson }},
      "mush-cut": {{ ('ket-lamps/mush-cut.webp' | asset_url) | tojson }},
      "mush-off": {{ ('ket-lamps/mush-off.webp' | asset_url) | tojson }},
      "mush-on": {{ ('ket-lamps/mush-on.webp' | asset_url) | tojson }},
      "rib-cut": {{ ('ket-lamps/rib-cut.webp' | asset_url) | tojson }},
      "rib-off": {{ ('ket-lamps/rib-off.webp' | asset_url) | tojson }},
      "rib-on": {{ ('ket-lamps/rib-on.webp' | asset_url) | tojson }}
    },
    products: [
      {% for p in R %}
        { id: {{ (p.id | string) | tojson }}, slug: {{ (p.slug or '') | tojson }}, ar: {{ p.name | tojson }}, en: {{ p.name | tojson }},
          url: {{ href(url_for('product_details', slug=p.slug)) }}, img: {{ pimg(p) | tojson }},
          price: {{ (p.sale_price if p.sale_price else p.price) | tojson }}, was: {{ (p.price if p.sale_price else 0) | tojson }},
          fprice: {{ (p.formatted_sale_price or p.formatted_price or '') | tojson }}, fwas: {{ (p.formatted_price if p.formatted_sale_price else '') | tojson }},
          hasOptions: {{ (p.has_options or false) | tojson }} }{{ ',' if not loop.last }}
      {% endfor %}
    ]
  };
</script>
<div class="kl">
<!-- LOADER: dots → line → logo → tables gather in a ring (plays on each visit; tap to skip) -->
<div class="loader" id="loader" aria-hidden="true">
  <div class="loader__dots" id="ldDots"><i></i><i></i><i></i></div>
  <p class="loader__line" id="ldLine" data-t="loadLine"></p>
  <div class="ring" id="ring"></div>
  <div class="loader__logo" id="ldLogo"></div>
  <button class="loader__skip" id="ldSkip" type="button" data-t="skipIntro"></button>
</div>


<!-- 1 · BANNER: the words alone on top, written by the scroll; then the lamp below switches on (a smooth fade, no flicker) -->
<section class="lhero" id="lhero" aria-labelledby="hTitle">
  <div class="container lhero__in" id="heroCard">
    <h1 class="lhero__h" id="hTitle"></h1>
    <div class="lhero__media">
      <button class="lhero__ph" id="heroPh" type="button" data-t-aria="tapLight">
        <img class="is-off" src="{{ 'ket-lamps/hero-off.webp' | asset_url }}" alt="" width="1002" height="1500" fetchpriority="high">
        <img class="is-on" src="{{ 'ket-lamps/hero-on.webp' | asset_url }}" alt="" width="1002" height="1500">
        <span class="lhero__glow" aria-hidden="true"></span>
      </button>
      <span class="hero__stat" id="hStat"></span>
      <span class="lhero__state" id="hState" aria-live="polite"></span>
      <a class="hero__shop" href="#all"><span data-t="hShop"></span><i class="flip" id="hShopIco"></i></a>
    </div>
  </div>
</section>

<!-- 2 · PICK THE SHAPE   → Vitrin: sub-categories (tiles) + theme settings (photo, headline) -->
<section class="section container" id="shape" aria-labelledby="shapeTitle">
  <p class="eyebrow" data-t="typesEy" style="margin-bottom:16px"></p>
  <div class="shape">
    <div class="shape__cols" id="shapeCols"></div>
    <div class="shape__big" data-reveal>
      <img class="sb__off" src="{{ 'ket-lamps/globe-off.webp' | asset_url }}" alt="" loading="lazy" width="844" height="1500"><img class="sb__on" src="{{ 'ket-lamps/globe-on.webp' | asset_url }}" alt="" loading="lazy" width="844" height="1500">
      <div><h2 id="shapeTitle"></h2><p data-t="shapeTx"></p></div>
      <div class="shape__bar">
        <a class="sbtn flip" href="#all" id="shapeGo" data-t-aria="cardBtn"></a>
        <div class="sseg" id="shapeSeg"></div>
        <span class="sav"><img src="{{ 'ket-lamps/lp06.webp' | asset_url }}" alt="" loading="lazy"></span>
      </div>
    </div>
  </div>
</section>

<!-- 3 · THE GALLERY: the lamps in a row; a tap carries the lamp into its exact spot in its room, the room fades in around it,
     then the room dims and the lamp glows. Arrows move straight to the next room; price and add to cart sit beside it -->
<section class="gx" id="glow" aria-labelledby="galTitle">
  <div class="gx__stage" id="gx">
    <div class="gx__scene" id="gxScene"><img class="gx__boff" alt=""><img class="gx__bon" alt=""><img class="gx__off" alt=""><img class="gx__on" alt="">
      <button class="gx__x" type="button" data-gx-close></button></div>
    <div class="gx__lamps" id="galRow"></div>
    <div class="gx__names" id="gxNames" aria-hidden="true"></div>
    <div class="container gx__head"><p class="eyebrow" data-t="galEy"></p><h2 id="galTitle" data-t="galH"></h2><p class="gx__tx" data-t="galTx"></p></div>
    <div class="gx__cap" id="gxCap"></div>
    <div class="gx__nav" id="gxNav"></div>
  </div>
</section>

<!-- 4 · ALL PRODUCTS   → Vitrin: category.products with Zid's filters / sort -->
<section class="section container" id="all" aria-labelledby="gridTitle">
  <div class="grid__head">
    <div><p class="eyebrow" data-t="gridEy"></p><h2 class="h-xl" id="gridTitle" style="margin-top:10px"><span data-t="gridH"></span><sup id="gridSup"></sup></h2></div>
  </div>
  <div class="bar">
    <div class="filters" id="filters" role="group"></div>
    <button class="lsw" id="lsw" type="button" role="switch" aria-checked="false"><span class="lsw__k" aria-hidden="true"></span><span class="lsw__t" id="lswT"></span></button>
    <label class="sortw"><span class="visually-hidden" data-t="sort"></span><select id="sort"></select><span id="sortIco"></span></label>
  </div>
  <p class="count" id="count" aria-live="polite"></p>
  <div class="pgrid" id="pgrid"></div>
  {% include "components/ket/category-pager.jinja" %}
</section>

<!-- 5 · COLLECTIONS -->
<section class="section container" aria-labelledby="colTitle">
  <div class="cols" id="cols">
    <div class="cols__head"><p class="eyebrow" data-t="colEy"></p><h2 id="colTitle" data-t="colH"></h2></div>
    <div class="cols__list" id="colList"></div>
    <div class="cfloat" id="cfloat"><img alt=""></div>
  </div>
</section>

<!-- 6 · INTRO BENTO   → Vitrin: category description + theme settings -->
<section class="section container" aria-labelledby="whyTitle">
  <div class="intro__grid">
    <div class="intro__left">
      <p class="eyebrow" data-t="whyEy"></p>
      <h2 class="intro__h" id="whyTitle" data-reveal><span data-t="whyA"></span><span class="ipill ipill--cut"><img src="{{ 'ket-lamps/lp23.webp' | asset_url }}" alt="" loading="lazy"></span><span data-t="whyB"></span></h2>
      <div class="chips" id="chips"></div>
      <div class="acc" id="acc"></div>
    </div>
    <div class="intro__card" data-reveal>
      <div class="intro__copy">
        <p class="eyebrow" id="cardEy"></p>
        <p data-t="cardTx"></p>
        <h3 data-t="cardH"></h3>
        <a class="btn btn-primary" href="#all"><span data-t="cardBtn"></span><span class="arr flip" id="cardArr"></span></a>
      </div>
      <div class="photo">
        <img src="{{ 'ket-lamps/bed-on.webp' | asset_url }}" alt="" loading="lazy" width="1200" height="1500" data-par>
        <span class="pill tag" id="saleChip"></span>
        <div class="stat">
          <div class="stat__row"><span class="stat__lbl" data-t="fromLbl"></span><span class="stat__big" id="statFrom"></span></div>
          <div class="stat__foot"><span class="stack" id="statStack"></span><span class="stat__lbl" id="statTx"></span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 7 · SIZE GUIDE (not for lamps) -->
<section class="section container" aria-labelledby="sizeTitle" hidden>
  <div class="size">
    <div class="size__copy">
      <p class="eyebrow eyebrow--o" data-t="sizeEy"></p>
      <h2 id="sizeTitle" data-t="sizeH"></h2>
      <p data-t="sizeTx"></p>
      <div class="range"><label for="sofa"><span data-t="sofa"></span><output id="sofaOut" for="sofa"></output></label><input type="range" id="sofa" min="160" max="320" step="10" value="240"></div>
      <div class="size__res"><div><span data-t="rec"></span><b id="recOut"></b></div><div><span data-t="gap"></span><b class="num"><span dir="ltr">40–45</span><small data-t="cm"></small></b></div></div>
      <button class="btn btn-primary" id="sizeBtn" type="button" style="justify-self:start;margin-top:6px"><span data-t="sizeBtn"></span><span class="arr flip" id="sizeArr"></span></button>
    </div>
    <div class="size__plan"><svg id="plan" viewBox="0 0 400 300" role="img" aria-label="Sofa and coffee table, top view"></svg></div>
  </div>
</section>

<!-- a band of words between two pictures -->
<section class="lband" aria-hidden="true"><div class="lband__track" id="lband"></div></section>

<!-- 8 · HELP -->
<section class="help" aria-labelledby="helpTitle">
  <div class="container">
    <div class="help__card" data-reveal>
      <div class="help__img"><img src="{{ 'ket-lamps/help-bed.webp' | asset_url }}" alt="" loading="lazy" style="object-fit:cover;mix-blend-mode:normal;padding:0;object-position:30% 40%"></div>
      <div class="help__copy"><h2 id="helpTitle" data-t="helpH"></h2><p data-t="helpTx"></p><a class="btn btn-wa" href="{{ KL_WA }}" target="_blank" rel="noopener"><span data-t="helpBtn"></span><span class="arr" id="helpArr"></span></a></div>
    </div>
  </div>
</section>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<!-- THE PRODUCT (on the live store: the product page). The energy bar sits under the price, like the "pieces left" bar, in green -->
<dialog class="pd" id="pd" aria-labelledby="pdName">
  <div class="pd__in" data-lenis-prevent>
    <button class="icon-btn pd__x" type="button" id="pdX" data-t-aria="pdClose"></button>
    <div class="pd__media" id="pdMedia"><img class="pd__off" alt=""><img class="pd__on" alt="">
      <button class="lsw pd__sw" id="pdSw" type="button" role="switch" aria-checked="false"><span class="lsw__k" aria-hidden="true"></span><span id="pdSwT"></span></button></div>
    <div class="pd__copy">
      <p class="eyebrow" data-t="tables"></p>
      <h2 id="pdName"></h2>
      <p class="card__price pd__price" id="pdPrice"></p>
      <div class="ebar" id="pdEco"></div>
      <div class="pd__buy"><div class="pd__qty"><button type="button" data-q="-1" aria-label="-">−</button><b id="pdQ">1</b><button type="button" data-q="1" aria-label="+">+</button></div>
        <button class="pd__add" type="button" id="pdAdd"></button></div>
      <a class="pd__page" id="pdPage" href="#" target="_blank" rel="noopener"></a>
    </div>
  </div>
</dialog>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
<script src="{{ 'ket-brand.js' | asset_url }}&k=fe6c0b2c"></script>
<script src="{{ 'ket-lamps.js' | asset_url }}&k=087b32a5"></script>

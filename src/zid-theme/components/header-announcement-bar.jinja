{#
  KET announcement bar: the pink scrolling strip (design: ket-product.html).
  Texts, link, on/off and pages come from the theme editor (Header → Announcement bar);
  with no texts entered it shows KET's three lines. Hover pauses it.
#}
{% if settings.announcement_bar_display | default(true) %}
  {% if not settings.announcement_bar_page_display or (session.template == 'home' and settings.announcement_bar_page_display == 'home') or settings.announcement_bar_page_display == 'all' %}
    {% set ns = namespace(texts=[]) %}
    {% for item in settings.announcement_bar_texts or [] %}
      {% if item.text %}{% set ns.texts = ns.texts + [item.text] %}{% endif %}
    {% endfor %}
    {% if not ns.texts %}
      {% set ns.texts = ['توصيل مجاني لكل مدن المملكة', 'هدية مجانية مع كل طلب', 'عروض اليوم الوطني السعودي'] if session.lang == 'ar'
                        else ['Free delivery across the Kingdom', 'A free gift with every order', 'Saudi National Day offer'] %}
    {% endif %}
    {% set speed = settings.announcement_bar_marquee_speed | default(32) %}
    {% set tag = 'a' if settings.announcement_bar_url else 'div' %}
    <{{ tag }} class="announce" data-announcement-bar role="region" aria-label="{{ _('Announcements') }}"
       {% if settings.announcement_bar_url %}href="{{ settings.announcement_bar_url }}"{% endif %}>
      <div class="marquee" style="animation-duration:{{ speed }}s">
        {% for g in range(2) %}
          <div class="marquee__group" {% if g %}aria-hidden="true"{% endif %}>
            {% for _r in range(2) %}{% for text in ns.texts %}<span>{{ text }}</span>{% endfor %}{% endfor %}
          </div>
        {% endfor %}
      </div>
    </{{ tag }}>
  {% endif %}
{% endif %}

{#
  KET header (design: ket-product.html). Zid's parts are kept as they are: the mobile drawer, main
  menu, search dialog, region / language dialog, login / profile buttons, cart badge and gift popup.
  The KET logo folds into the smile once the page scrolls (assets/ket-site.js).
#}
{% import 'components/ket/icons.jinja' as k %}
<div class="sticky top-0 z-50 ket ket-top" id="ket-top">
  {% include 'components/header-announcement-bar.jinja' %}
  <header class="header" id="header">
    <div class="container header__inner">
      <div class="header__start">
        {% include 'components/header/mobile-drawer.jinja' %}
        {% include 'components/header/search.jinja' %}
        <div class="ket-nav hide-mob">{% include 'components/header/main-nav.jinja' %}</div>
      </div>
      <a href="/" class="logo" id="logo" aria-label="{{ store.name }} · {{ _('Home') }}">{{ k.logo(64) }}</a>
      <ul class="header__end">
        <li class="hidden lg:block">
          <button
            id="header-login-btn"
            type="button"
            onclick="handleLoginAction()"
            class="icon-btn"
            aria-label="{{ _('Login') }}"
          >
            {{ k.icon('user') }}
          </button>
          <a
            id="header-profile-btn"
            href="{{ url_for('profile') }}"
            class="icon-btn hidden"
            aria-label="{{ _('Profile') }}"
          >
            {{ k.icon('user') }}
          </a>
        </li>
        <li class="relative">
          <a
            href="{{ url_for('cart_page') }}"
            class="icon-btn cart-btn" aria-label="{{ _('Cart') }}"
          >
            {{ k.icon('bag') }}
            <span
              data-cart-badge
              hidden
              class="cart-count"
            >
              0
            </span>
          </a>
          
          {% if store.settings.checkout.gift_order_settings.is_gift_order_enabled == '1' and store.settings.checkout.gift_order_settings.is_gift_order_customer_motivation_enabled == '1' and settings.gifting_add_to_cart_popup | default(true) %}
            <div
              hidden
              data-gift-cart-popup
              class="bg-background border-border-light absolute end-0 top-full z-50 mt-2 flex items-center gap-3 rounded border px-4 py-3 shadow-md"
            >
              <a
                href="{{ url_for('cart_page') }}"
                class="text-sm flex items-center gap-2 whitespace-nowrap"
              >
                <span class="text-foreground font-medium">{{ _("Want to send a gift order?") }}</span>
                <span class="text-muted">{{ _("Check the cart") }}</span>
              </a>
              <svg
                class="text-accent size-10 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M20 12v10H4V12M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
              <button
                type="button"
                data-gift-popup-close
                class="text-foreground flex size-6 shrink-0 items-center justify-center"
                aria-label="{{ _('Close') }}"
              >
                <svg
                  class="size-4"
                  viewBox="0 0 16 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12 4L4 12M4 4l8 8"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  ></path>
                </svg>
              </button>
            </div>
          {% endif %}
        </li>
        {% set langs = store.languages or [] %}
        {% if langs | length > 1 %}
          {% set other = 'en' if session.lang == 'ar' else 'ar' %}
          <li><button type="button" class="lang-btn latin" onclick="selectMobileLanguage('{{ other }}')" aria-label="{{ 'Switch to English' if other == 'en' else 'التبديل إلى العربية' }}">{{ 'EN' if other == 'en' else 'ع' }}</button></li>
        {% endif %}
        {% include 'components/header/region-selector.jinja' %}
      </ul>
    </div>
  </header>
</div>

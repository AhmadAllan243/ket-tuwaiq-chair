{#
  KET home page (design: ket-home.html). Generated by ket/build_home.py: edit the prototype, this data block
  (ket/ket-home.data.jinja) or the script, then run the build. Everything left empty in the theme editor
  falls back to the prototype's wording and pictures.
#}
{% set S = settings %}
{% macro pic(v, w=900) %}{{ (image_url(v, w=w, q=85, f='auto') if v else '') | tojson }}{% endmacro %}
{% macro href(v) %}{{ ((v._url if v and v._url else (v.url if v and v.url is string else (v or ''))) ~ '') | tojson }}{% endmacro %}
{% macro txt(v) %}{{ (v or '') | tojson }}{% endmacro %}
<link rel="stylesheet" href="{{ 'ket-home.css' | asset_url }}">
<script>
  document.documentElement.classList.add('is-intro');   // the welcome (short once seen this visit) ends by handing over to the search bar
  window.KET_HOME = {
    base: {{ ('ket-home/home-lady.webp' | asset_url) | tojson }}.replace(/home-lady\.webp.*$/, ''),
    links: { instagram: {{ href(S.instagram) }}, tiktok: {{ href(S.tiktok) }} },
    saleUrl: {{ href(S.sale_url) }},
    lady: {{ pic(S.lady, 700) if S.lady else ('home/lady' | tojson) }},
    fan: [{{ pic(S.sale_image1, 400) if S.sale_image1 else ('cut/ac03' | tojson) }}, {{ pic(S.sale_image2, 400) if S.sale_image2 else ('cut/lp10' | tojson) }}, {{ pic(S.sale_image3, 400) if S.sale_image3 else ('cut/t13' | tojson) }}],
    text: {
      heroH: {{ txt(S.hero_title) }}, heroTx: {{ txt(S.hero_text) }},
      brandT: {{ txt(S.brand_title) }}, brandT2: {{ txt(S.brand_title2) }}, pill1: {{ txt(S.pill1) }}, pill2: {{ txt(S.pill2) }},
      featT: {{ txt(S.sale_title) }}, clrEy: {{ txt(S.deals_eyebrow) }}, clrH: {{ txt(S.deals_title) }}, clrTx: {{ txt(S.deals_text) }},
      expH: {{ txt(S.videos_title) }}, expTx: {{ txt(S.videos_text) }}
    },
    depts: {
      {% for id in ['tables', 'trees', 'home', 'rugs', 'lamps'] %}
        {% set c = S['dept_' ~ id] %}
        {{ id }}: {
          name: {{ txt(c.name if c and c.id else '') }},
          url: {{ txt(('/categories/' ~ c.id ~ '/' ~ c.slug) if c and c.id else '') }},
          n: {{ (c.products_count if c and c.products_count else 0) | tojson }},
          text: {{ txt(S['dept_' ~ id ~ '_text']) }},
          photo: {{ pic(S['dept_' ~ id ~ '_image'], 1100) if S['dept_' ~ id ~ '_image'] else ('' | tojson) }}
        }{{ ',' if not loop.last }}
      {% endfor %}
    },
    floats: [
      {% set fl = safeget(S, 'floats', []) %}
      {% if fl %}
        {% for f in fl %}{ img: {{ pic(f.image, 400) }}, url: {{ href(f.url) }}, cut: {{ (f.cutout or false) | tojson }} }{{ ',' if not loop.last }}{% endfor %}
      {% else %}
        { img: 'home/lp03', cut: true }, { img: 'home/life/family' }, { img: 'home/tr06', cut: true },
        { img: 'tables/t12', cut: true }, { img: 'home/life/tables' }, { img: 'home/life/home' }
      {% endif %}
    ],
    {% set st = safeget(S, 'story', []) %}
    st: [{% for s in st %}{% if s.text_a or s.text_h %}[{{ txt(s.text_a) }}, {{ txt(s.text_h) }}, {{ txt(s.text_b) }}]{{ ',' if not loop.last }}{% endif %}{% endfor %}],
    story: [
      {% if st %}
        {% for s in st %}{ img: {{ pic(s.image, 800) }}, name: {{ txt(s.title) }}, price: {{ txt(s.price) }}, url: {{ href(s.url) }} }{{ ',' if not loop.last }}{% endfor %}
      {% else %}
        { img: 'tables/t08' }, { img: 'home/lp11' }, { img: 'home/ac05' }
      {% endif %}
    ],
    {% set deals = S.deals.results if S.deals and S.deals.results else [] %}
    {% set scale = S.deals_stock_scale or 30 %}
    products: [
      {% for p in deals %}
        {% set im = p.main_image.image.large if p.main_image and p.main_image.image else (p.images[0].image.full_size if p.images else '') %}
        { id: {{ p.id | tojson }}, ar: {{ txt(p.name) }}, en: {{ txt(p.name) }}, url: {{ href(url_for('product_details', slug=p.slug)) }},
          img: {{ pic(im, 800) if im else ('' | tojson) }}, price: {{ (p.sale_price if p.sale_price else p.price) | tojson }}, was: {{ (p.price if p.sale_price else 0) | tojson }},
          fprice: {{ txt(p.formatted_sale_price or p.formatted_price) }}, fwas: {{ txt(p.formatted_price if p.formatted_sale_price else '') }},
          hasOptions: {{ (p.has_options or false) | tojson }} }{{ ',' if not loop.last }}
      {% endfor %}
    ],
    clearance: [
      {% for p in deals %}
        { id: {{ p.id | tojson }}, left: {{ (p.quantity if p.quantity and not p.is_infinite else 0) | tojson }}, total: {{ scale | tojson }} }{{ ',' if not loop.last }}
      {% endfor %}
    ],
    videos: [
      {% set vs = safeget(S, 'videos', []) %}
      {% if vs %}
        {% for v in vs %}{ poster: {{ pic(v.poster, 700) }}, video: {{ href(v.video) }}, title: {{ txt(v.title) }}, sub: {{ txt(v.subtitle) }} }{{ ',' if not loop.last }}{% endfor %}
      {% else %}
        { poster: 'home/v1' }, { poster: 'home/v4' }, { poster: 'home/v2' }, { poster: 'home/v5' }, { poster: 'home/v3' }, { poster: 'home/v6' }
      {% endif %}
    ]
  };
  KET_HOME.products.forEach(p => { p.price = +p.price || 0; p.was = +p.was || 0; if (p.was && p.was <= p.price) p.was = 0; });
  KET_HOME.clearance.forEach(d => { d.price = (KET_HOME.products.find(p => p.id === d.id) || {}).price || 0; d.left = +d.left || 0; d.total = Math.max(+d.total || 1, d.left); });
</script>

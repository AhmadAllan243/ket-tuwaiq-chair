{#
  KET footer (design: ket-product.html), on the store's own Zid data: footer link groups and
  "about" text (theme editor), social accounts, phone and email (store settings), the store's
  payment methods, VAT / CR numbers, the Saudi Business Center certificate and app links.
#}
{% import 'components/ket/icons.jinja' as k %}
{% set c = store.settings.contact %}
{% set g = store.settings.general %}
<footer id="footer" class="ket footer">
  <div class="container">
    {% set groups = [] %}
    {% for group in settings.link_groups_items or [] %}
      {% if not group.hide and group.links %}{% set _x = groups.append(group) %}{% endif %}
    {% endfor %}
    {% if groups or settings.about_us_about_us %}
      <div class="footer__links">
        {% if settings.about_us_about_us %}
          <div class="footer__about">{{ settings.about_us_about_us | safe }}</div>
        {% endif %}
        {% for group in groups %}
          <nav class="footer__group" aria-label="{{ group.title or store.name }}">
            {% if group.title %}<h3>{{ group.title }}</h3>{% endif %}
            <ul>{% for link in group.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>
          </nav>
        {% endfor %}
      </div>
    {% endif %}

    <div class="footer__grid">
      <div class="footer__mark">
        {{ k.smile(64) }}
        <p class="footer__copy">© {{ _("All rights reserved") }}</p>
      </div>

      {% if c.snapchat or c.instagram or c.tiktok or c.twitter or c.facebook or c.phone or c.email %}
      <div class="footer__touch">
        <p>{{ c.title or _("Get in touch:") }}</p>
        <div class="social">
          {% if c.snapchat %}<a href="https://www.snapchat.com/add/{{ c.snapchat }}" target="_blank" rel="noopener" aria-label="Snapchat">{{ k.icon('snap', 20) }}</a>{% endif %}
          {% if c.instagram %}<a href="https://www.instagram.com/{{ c.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{{ k.icon('ig', 20) }}</a>{% endif %}
          {% if c.tiktok %}<a href="https://www.tiktok.com/@{{ c.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{{ k.icon('tiktok', 20) }}</a>{% endif %}
          {% if c.twitter %}<a href="https://twitter.com/{{ c.twitter }}" target="_blank" rel="noopener" aria-label="X">{{ k.icon('x', 20) }}</a>{% endif %}
          {% if c.facebook %}<a href="https://www.facebook.com/{{ c.facebook }}" target="_blank" rel="noopener" aria-label="Facebook"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5a.5.5 0 0 1 .5-.5Z"/></svg></a>{% endif %}
          {% if c.phone %}<a href="https://wa.me/{{ c.phone | replace('+', '') | replace(' ', '') }}" target="_blank" rel="noopener" aria-label="WhatsApp">{{ k.icon('wa', 20) }}</a>{% endif %}
          {% if c.email %}<a href="mailto:{{ c.email }}" aria-label="Email">{{ k.icon('mail', 20) }}</a>{% endif %}
        </div>
      </div>
      {% endif %}

      {# payment methods as the prototype's black marks; any method without a KET mark shows Zid's icon in greyscale #}
      {% set pays = store.settings.checkout.payment_methods or [] %}
      {% if pays %}
        <div class="pays" aria-label="{{ _('Payment methods') }}">
          {% for pm in pays %}
            {% set n = ((pm.code or '') ~ ' ' ~ (pm.name or '')) | lower %}
            {% if 'apple' in n %}<span class="pay pay--apple"><svg width="17" height="20" viewBox="0 0 17 20" aria-hidden="true"><path fill="#111" d="M14 10.6c0-2.3 1.9-3.4 2-3.5a4.3 4.3 0 0 0-3.4-1.8c-1.4-.2-2.8.8-3.5.8s-1.8-.8-3-.8A4.5 4.5 0 0 0 2.4 7.6c-1.6 2.8-.4 6.9 1.1 9.2.8 1.1 1.7 2.3 2.9 2.3s1.6-.8 3-.8 1.8.8 3 .7 2-1.1 2.8-2.2a9.8 9.8 0 0 0 1.3-2.6A3.9 3.9 0 0 1 14 10.6ZM11.7 3.8A4 4 0 0 0 12.6.9a4.1 4.1 0 0 0-2.7 1.4 3.8 3.8 0 0 0-.9 2.8 3.4 3.4 0 0 0 2.7-1.3Z"/></svg>Pay</span>
            {% elif 'visa' in n %}<span class="pay pay--visa">VISA</span>
            {% elif 'master' in n %}<span class="pay pay--mc" aria-label="Mastercard"><svg width="36" height="24" viewBox="0 0 36 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="#111"/><circle cx="24" cy="12" r="11" fill="#111" fill-opacity=".45"/><path d="M18 2.8a11 11 0 0 1 0 18.4a11 11 0 0 1 0-18.4z" fill="#111" fill-opacity=".3"/></svg></span>
            {% elif 'mada' in n or 'مدى' in n %}<span class="pay pay--mada"><i></i>mada</span>
            {% elif 'amex' in n or 'american' in n %}<span class="pay pay--amex">AMERICAN<br>EXPRESS</span>
            {% elif 'tabby' in n or 'تابي' in n %}<span class="pay pay--tabby">tabby</span>
            {% elif 'tamara' in n or 'تمارا' in n %}<span class="pay pay--tamara">tamara</span>
            {% elif 'stc' in n %}<span class="pay pay--stc">stc pay</span>
            {% elif 'flow' in n %}<span class="pay pay--flow">Flow</span>
            {% elif pm.icon %}<span class="pay pay--img"><img src="{{ image_url(pm.icon, w=96, q=100) }}" alt="{{ pm.name }}" height="24" loading="lazy"></span>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <div class="footer__legal">
        {% if c.business_center %}
          <a class="sbc" href="https://eauthenticate.saudibusiness.gov.sa/certificate-details/{{ c.business_center }}" target="_blank" rel="noopener">{{ _("Verified by the Saudi Business Center") }}</a>
        {% endif %}
        {% if g.tax_settings.tax_number or g.commercial_registration_number %}
          <span class="ids">
            {% if g.tax_settings.tax_number %}
              <span>{% if g.tax_settings.is_certificate_visible and g.tax_settings.tax_registration_certificate %}<a href="{{ g.tax_settings.tax_registration_certificate }}" target="_blank" rel="noopener">{{ _("VAT number:") }} {{ g.tax_settings.tax_number }}</a>{% else %}{{ _("VAT number:") }} {{ g.tax_settings.tax_number }}{% endif %}</span>
            {% endif %}
            {% if g.commercial_registration_number %}<span>{{ _("The commercial register number:") }} {{ g.commercial_registration_number }}</span>{% endif %}
          </span>
        {% endif %}
        {% if g.one_signal.ios_app_id %}
          <a href="https://apps.apple.com/app/id{{ g.one_signal.ios_app_id }}" target="_blank" rel="noopener"><img src="{{ 'images/app-store-logo.svg' | asset_url }}" alt="App Store" height="36" loading="lazy"></a>
        {% endif %}
        {% if g.one_signal.android_package_name %}
          <a href="https://play.google.com/store/apps/details?id={{ g.one_signal.android_package_name }}" target="_blank" rel="noopener"><img src="{{ 'images/google-play-logo.svg' | asset_url }}" alt="Google Play" height="36" loading="lazy"></a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>
